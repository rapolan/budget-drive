NODE_ENV=test
# Matches production (TZ=UTC in .env.example/CI, item 7) - the test suite
# must exercise the same "server timezone is irrelevant" guarantee it runs
# under in production, not whatever the developer's machine happens to be.
TZ=UTC
DB_HOST=localhost
DB_PORT=5432
DB_NAME=test_db
DB_USER=test
DB_PASSWORD=test
JWT_SECRET=test-jwt-secret-at-least-32-characters-long
JWT_EXPIRE=1h
ALLOWED_ORIGINS=http://localhost:5173
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100
LOG_LEVEL=error
BSV_ENABLED=false
